# 扶摇（确定性字段）
FUYAO_API_KEY=
FUYAO_BASE_URL=https://fuyao.aicubes.cn

# iFinD MCP（NL 候选 / 宏观资讯增强）
IFIND_MCP_TOKEN=
IFIND_MCP_BASE=https://api-mcp.51ifind.com:8643/ds-mcp-servers

# 演示/外网不通：fixture + off（不请求扶摇/iFinD，避免 Connect Timeout）
# 真实行情：auto（有 Key 则拉扶摇；有 Token 则启用 iFinD）
DATA_MODE=fixture
# DATA_MODE=auto|fuyao|fixture
IFIND_ENABLED=off
# IFIND_ENABLED=auto|on|off

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
